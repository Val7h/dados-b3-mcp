{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Val7h/dados-b3",
  "title": "Dados B3",
  "description": "Brazilian stocks (B3): 36 read-only tools for fundamentals, dividends, FIIs, ETFs, BDRs. Free.",
  "websiteUrl": "https://dadosb3.com/conector",
  "icons": [
    {
      "src": "https://dadosb3.com/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    },
    {
      "src": "https://dadosb3.com/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "version": "1.9.2",
  "repository": {
    "url": "https://github.com/Val7h/dados-b3-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://dadosb3.com/mcp/"
    }
  ],
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/val7h/dados-b3-mcp:1.9.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DADOS_B3_API_KEY",
          "description": "Dados B3 API key. Optional: WEGE3 and the whole methodology are free without one. Create a free key (200 queries/day, no card) or subscribe at https://dadosb3.com.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
